# =============================================================================
# QA Toolkit - configuración
# -----------------------------------------------------------------------------
# 1. Copiá este archivo a ".env" (cp .env.example .env) y completá tus valores.
#    Alternativa: completá la pestaña "Conexión" de la app y usá
#    "Guardar configuración": genera el .env por vos.
# 2. ".env" está en .gitignore: es personal, nunca lo subas ni lo compartas.
# 3. Guía paso a paso para conseguir estos datos en Azure DevOps:
#    docs/AZURE_DEVOPS_SETUP.md
# =============================================================================

# ----------------------------- CONEXIÓN (obligatoria) ------------------------

# URL de la organización (Azure DevOps Services) o de la colección (Server on-premise).
# NO incluye el nombre del proyecto ni barra final.
#   Services:  https://dev.azure.com/mi-organizacion
#   Server:    https://mi-servidor/mi-coleccion
AZDO_URL=https://dev.azure.com/TU_ORGANIZACION

# Nombre exacto del proyecto (respeta mayúsculas y espacios). Está en la URL:
#   https://dev.azure.com/mi-organizacion/NOMBRE_DEL_PROYECTO
PROJECT=TU_PROYECTO

# Versión de la API REST usada por el importador. Debe soportarla tu servidor:
#   Azure DevOps Services -> 7.1 | Server 2022 -> 7.0 | Server 2020 -> 6.0 | Server 2019 -> 5.0 / 5.1
# Si da error 404 en "Probar conexión", probá con una versión menor.
API_VERSION=5.1

# Certificados HTTPS. Si tu servidor usa una CA interna (típico en redes corporativas),
# dejá USE_SYSTEM_CERTS=true para usar el almacén de certificados del sistema.
# VERIFY_SSL=false desactiva la validación: usalo solo como último recurso.
USE_SYSTEM_CERTS=true
VERIFY_SSL=true

# Personal Access Token (PAT). Recomendado: dejarlo comentado y pegarlo en la app,
# donde queda solo en memoria. Si lo descomentás, el token queda en texto plano en este archivo.
# Scopes necesarios: Work Items (Read & write) y Test Management (Read & write).
# Cómo crearlo: docs/AZURE_DEVOPS_SETUP.md
# AZDO_PAT=

# ------------------------- IMPORTADOR DE TEST CASES --------------------------

# Nombre del Test Plan destino. Solo se muestra en los logs; no afecta la carga.
TEST_PLAN_NAME=

# IDs numéricos del Test Plan y de la Test Suite destino. Se ven en la URL al abrir
# la suite en Test Plans:  .../_testPlans/execute?planId=1234&suiteId=1235
PLAN_ID=0
SUITE_ID=0

# Ruta completa al Excel con los casos y nombre de su hoja.
# Podés generar una plantilla con el botón "Generar plantilla Excel".
EXCEL_FILE=
EXCEL_SHEET_NAME=Casos de prueba

# true = procesa solo la primera fila (útil para probar la configuración antes de cargar todo).
SOLO_PRIMER_CASO=false

# --------------------------- REPORTES DE TEST PLANS --------------------------

# Versión de la API para los reportes (4.1 funciona también en servidores antiguos).
REPORTS_API_VERSION=4.1

# Nombres (o parte del nombre) de los planes a incluir, separados por coma.
# Vacío = todos. Ej: Plan_Regresion_1, Plan_Regresion_2
FILTRO_PLANES=

# true = incluye también los planes inactivos.
INCLUIR_INACTIVOS=false

# Excel de salida que consume Power BI. Por defecto: output/testplans_resultados.xlsx
# REPORTS_OUTPUT_FILE=
